# Copy to .env and fill in. .env is gitignored and is the only place a key
# should be written. A real deployment sets these as environment variables
# and has no .env at all.

# Signs bearer tokens. Set this anywhere that is not a laptop: the fallback
# is a development constant and a token signed with it is worth nothing.
TREASURY_TOKEN_SECRET=

# The advisory layer's model, stage 4 of six. Leave it empty and the stub
# ranker runs instead: the recommendation still appears, the validation
# still runs, and the interface is unchanged.
TREASURY_MODEL_API_KEY=

# Which model. Defaults to openai/gpt-oss-120b on Groq. Check the key can
# actually reach the name you set; a name it cannot is a 404, not a warning.
TREASURY_MODEL_NAME=
